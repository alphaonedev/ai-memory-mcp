[Unit]
Description=ai-memory wake-hub — refresh the derived public identity snapshot
Documentation=https://github.com/alphaonedev/ai-memory-mcp/blob/main/docs/wake-hub.md
# The hub REFUSES every hello once the snapshot is older than 60 s
# (identity::hub_cache::MAX_CACHE_AGE_SECS), so this unit is what keeps the
# hub admitting anyone at all. It is deliberately a SEPARATE unit from
# ai-memory-wake-hub.service: this one opens the store, and the hub process
# must never do that.
#
# /run is a tmpfs, so after a reboot the snapshot is GONE and the hub admits
# nobody until this unit has run once. That is what OnBootSec=15s in the
# companion timer is for: the first refresh after boot is what lets the hub
# admit anyone at all.
After=ai-memory.service ai-memory-wake-hub.service

[Service]
Type=oneshot
User=ai-memory
Group=ai-memory

# Derives the snapshot from the durable v97 identity root, audits the
# allow/revoke decisions onto the signed_events spine, and publishes it
# atomically (temp file + rename in the same directory, mode 0600 on the new
# inode). A failed derivation publishes NOTHING: the previous snapshot stays
# in place and ages out, which refuses hellos rather than admitting a stale
# or partial one.
#
# EDIT THE PRINCIPAL LIST. Every agent that may join the hub is named with its
# own --include-agent; omitting one on the next refresh REVOKES it, which is
# the intended revocation mechanism. Add --daemon-producer only if this host's
# daemon pushes wakes (see docs/wake-hub.md).
# Derive as User=ai-memory (this unit OPENS the store). The hub process
# is User=ai-memory-hub and AllowlistFile::load_from_file requires the
# snapshot be owned by THAT uid at exact mode 0600, so ExecStartPost hands
# the file into the hub runtime directory as root (`+` prefix ignores User=
# and the sandbox — CAP_CHOWN is otherwise unavailable to ai-memory).
#
# #3637 (M4) — the root step is `wake-hub --publish-snapshot`, NOT
# install(1). /var/lib/ai-memory is writable by the ai-memory uid, and
# install(1) dereferences its source and unlinks-then-recreates its
# destination: a symlink swapped in there made root copy any file it can
# read into the hub directory (CWE-59), and the hub could find no snapshot
# mid-copy. --publish-snapshot follows no symlink on either path, accepts
# only a single-link 0600 source owned by its directory's owner, fully
# validates the snapshot, and renames a 0600 inode owned by the hub
# directory's owner into place atomically. A refusal publishes nothing; a
# failed directory fsync AFTER the rename fails the unit with an error saying
# the validated snapshot WAS published but its durability is unconfirmed.
# AI_MEMORY_NO_CONFIG=1 keeps the root step from reading (or seeding) root's
# ai-memory config: it needs nothing but the two explicit paths.
ExecStart=/usr/bin/ai-memory --db /var/lib/ai-memory/ai-memory.db \
    identity hub-cache \
    --include-agent REPLACE_AGENT_ID \
    --out /var/lib/ai-memory/hub-allow.json
ExecStartPost=+/usr/bin/env AI_MEMORY_NO_CONFIG=1 /usr/bin/ai-memory wake-hub \
    --publish-snapshot /var/lib/ai-memory/hub-allow.json \
    --allowlist /run/ai-memory-hub/hub-allow.json

# --- hardening ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@mount @swap @reboot @obsolete
CapabilityBoundingSet=
AmbientCapabilities=
# Staging snapshot (public keys only) lives next to the store. The hub
# runtime directory is 0700 ai-memory-hub, so this unit cannot write it
# directly; ExecStartPost=+wake-hub --publish-snapshot is the hand-off
# (#3578, hardened by #3637).
# The DIRECTORY, not the database file, exactly as ai-memory.service grants it
# ("Only touch AI_MEMORY_DB's parent"). SQLite runs the store in WAL mode, and
# WAL mode creates and locks `ai-memory.db-wal` and `ai-memory.db-shm` BESIDE
# the database — a reader opens them too, and this unit is not even a pure
# reader: `identity hub-cache` audits its allow/revoke decisions onto the
# signed_events spine. Granting only the .db file leaves the parent read-only
# under ProtectSystem=strict, so the run fails, publishes nothing, the previous
# snapshot ages past the hub's 60 s ceiling and the hub refuses every hello.
# Fail-closed, but a dead deployment. Keep the directory, and keep the
# database's parent 0750 ai-memory:ai-memory (the package installer's mode).
# An operator who keeps the database elsewhere names THAT directory here.
ReadWritePaths=/var/lib/ai-memory

# Bounded so a wedged run cannot pile up behind the next timer tick. The hub
# tolerates a missed refresh by refusing hellos, never by admitting stale
# authority, so failing fast is the safe direction.
TimeoutStartSec=20s
