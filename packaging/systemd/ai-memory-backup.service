[Unit]
Description=ai-memory backup — snapshot SQLite database
Documentation=https://github.com/alphaonedev/ai-memory-mcp
# Run after the main service has started so the DB path is guaranteed to exist.
After=ai-memory.service

[Service]
Type=oneshot
User=ai-memory
Group=ai-memory
Environment=AI_MEMORY_DB=/var/lib/ai-memory/ai-memory.db
WorkingDirectory=/var/lib/ai-memory
# The backup CLI takes a snapshot via SQLite's `VACUUM INTO` (hot-backup-safe)
# and writes a manifest.json alongside it. --keep rotates oldest snapshots.
ExecStart=/usr/bin/ai-memory backup --to /var/lib/ai-memory/backups --keep 48
# Optional off-box push via AWS SDK — uncomment and set env if desired.
# ExecStartPost=/usr/bin/ai-memory backup push --remote s3://my-bucket/ai-memory/

# --- hardening ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@mount @swap @reboot @obsolete
CapabilityBoundingSet=
AmbientCapabilities=
# `backup` opens the database through the unmigrated egress funnel (#4207): it
# never migrates, so a newer binary on disk cannot upgrade the live primary
# under a still-running older daemon. The grant is the whole state directory
# (/var/lib/ai-memory): SQLite needs to create the WAL/SHM sidecars beside the
# database file, and the backups directory lives under it. This is wider than
# the pre-#4080 read-only database path and is a deliberate loosening.
ReadWritePaths=/var/lib/ai-memory
# #4325 — under ProtectSystem=strict the service user's HOME is the state
# dir, so the grant above also covered <HOME>/.config/ai-memory/keys: the
# operator signing key and the local TLS CA. The backup only READS the
# signing key (its best-effort default write tolerates a read-only config
# dir), so the key store is read-only inside the job. The nested read-only
# mount wins over the enclosing read-write one; `-` because the directory
# exists only once a key has been written.
ReadOnlyPaths=-/var/lib/ai-memory/.config

TimeoutStartSec=15min
