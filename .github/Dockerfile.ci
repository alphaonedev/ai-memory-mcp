#
# ai-memory prebuilt CI container image (build lever #3, refs #2960/#3089).
#
# WHY THIS IMAGE EXISTS. Every postgres-backed CI job today does two flaky,
# slow things at job start:
#
#   1. It `apt-get install`s the Rust build deps (mold, postgresql-client,
#      jq, sqlite3, build-essential) from the runner's apt mirror — the
#      exact hang-until-timeout failure #3090 bounded but could not
#      eliminate (a stalled mirror still costs the retry budget + minutes).
#   2. The certified pg+AGE+pgvector job additionally `docker build`s the
#      certified data tier (base image + pgdg apt + AGE source) on EVERY run — pulling
#      the base image and re-running the same apt layers each time.
#
# Baking BOTH into one prebuilt image, published once to GHCR and pulled by
# the jobs, moves those apt/build steps off the hot path: the mirror flake
# now only exists at the rare image-rebuild moment (a Dockerfile.ci or SSOT
# pin change), never on the per-PR path. When it is used, a job pulls a
# ready image instead of re-deriving it.
#
# ------------------------------------------------------------------------
# LAYER 1 — CERTIFIED DATA TIER (byte-identical to the shipped deploy image)
# ------------------------------------------------------------------------
# This layer is the SAME recipe as deploy/docker-1461/Dockerfile.pg-age-vector
# (the image the docker-1461 mesh ships): the SAME official PostgreSQL base
# image, the SAME pgdg `apt --only-upgrade` to the exact server minor, the
# SAME Apache AGE source build at the ONE pinned upstream commit (checked
# with `git rev-parse HEAD`; a mismatch fails the build), the SAME one
# upstream fix applied by apply_age_patch.py from the named build context
# `age-provision` (#9965), the SAME pinned pgvector .deb. Apache AGE 1.7.0,
# built from upstream PG19 branch commit c6b043d plus upstream fix commit
# 06ce678d (apache/age#2581) (not a tagged Apache release; upstream has no
# 1.7.0 release for PostgreSQL 19). "Extend prior art, do not fork it" (CLAUDE.md): no version
# literal is typed here — every pin arrives as a --build-arg resolved from the
# ONE SSOT, deploy/docker-1461/provision/lib.sh (PG_BASE_IMAGE / PG_MAJOR /
# PG_APT_VERSION / AGE_SOURCE_REPO / AGE_SOURCE_COMMIT / PGVECTOR_APT_VERSION),
# and a missing build arg fails the build. The published image's tag encodes
# the resolved triple (see .github/workflows/publish-ci-image.yml), so a
# future pin bump produces a new tag. AGE's initdb script is copied in and
# postgres starts with `shared_preload_libraries=age`, so `docker run` starts
# postgres exactly as the deploy image does.
ARG PG_BASE_IMAGE
FROM ${PG_BASE_IMAGE} AS age-build

ARG PG_MAJOR
ARG PG_APT_VERSION
ARG AGE_SOURCE_REPO
ARG AGE_SOURCE_COMMIT

USER root

# The one upstream AGE fix of the certified build (#9965): the SSOT, the
# applier and the patch file it pins, from the named build context
# `age-provision` (= deploy/docker-1461/provision; publish-ci-image.yml passes
# it). apply_age_patch.py refuses any other source, patch or result.
COPY --from=age-provision lib.sh apply_age_patch.py /age-provision/
COPY --from=age-provision patches/ /age-provision/patches/

RUN : "${PG_MAJOR:?}" "${PG_APT_VERSION:?}" "${AGE_SOURCE_REPO:?}" "${AGE_SOURCE_COMMIT:?}" \
 && apt-get update \
 && apt-get install -y --no-install-recommends --only-upgrade \
      "postgresql-${PG_MAJOR}=${PG_APT_VERSION}" \
      "postgresql-client-${PG_MAJOR}=${PG_APT_VERSION}" \
 && apt-get install -y --no-install-recommends \
      "postgresql-server-dev-${PG_MAJOR}=${PG_APT_VERSION}" \
      bison build-essential ca-certificates flex git python3 \
 && git init -q /src/age \
 && git -C /src/age remote add origin "${AGE_SOURCE_REPO}" \
 && git -C /src/age fetch -q --depth 1 origin "${AGE_SOURCE_COMMIT}" \
 && git -C /src/age checkout -q --detach FETCH_HEAD \
 && test "$(git -C /src/age rev-parse HEAD)" = "${AGE_SOURCE_COMMIT}" \
 && python3 /age-provision/apply_age_patch.py --ssot /age-provision/lib.sh --src /src/age \
 && make -C /src/age -j"$(nproc)" PG_CONFIG="/usr/lib/postgresql/${PG_MAJOR}/bin/pg_config" \
 && make -C /src/age install DESTDIR=/age-dist PG_CONFIG="/usr/lib/postgresql/${PG_MAJOR}/bin/pg_config" \
 && python3 /age-provision/apply_age_patch.py --ssot /age-provision/lib.sh --src /src/age --verify \
 && install -D -m 0644 /src/age/docker/docker-entrypoint-initdb.d/00-create-extension-age.sql \
      /age-dist/docker-entrypoint-initdb.d/00-create-extension-age.sql

ARG PG_BASE_IMAGE
FROM ${PG_BASE_IMAGE}

# Re-declare post-FROM so the build args are in scope for the RUN layer.
ARG PG_MAJOR
ARG PG_APT_VERSION
ARG PGVECTOR_APT_VERSION
ARG AGE_SOURCE_COMMIT

USER root

# Pinned, reproducible data tier: exact minor for server + client and exact
# pgvector from pgdg apt; AGE from the pinned-commit build stage above.
# Identical commands to deploy/docker-1461/Dockerfile.pg-age-vector (kept in
# lockstep via the shared SSOT build-args); no plaintext-refusing hostssl
# HEALTHCHECK is layered on here — CI reaches this container over loopback and
# gates readiness with its own `pg_isready`, so the deploy image's mTLS-posture
# healthcheck (which assumes provisioned TLS material) is deliberately omitted.
RUN : "${PG_MAJOR:?}" "${PG_APT_VERSION:?}" "${PGVECTOR_APT_VERSION:?}" \
 && apt-get update \
 && apt-get install -y --no-install-recommends --only-upgrade \
      "postgresql-${PG_MAJOR}=${PG_APT_VERSION}" \
      "postgresql-client-${PG_MAJOR}=${PG_APT_VERSION}" \
 && apt-get install -y --no-install-recommends \
      "postgresql-${PG_MAJOR}-pgvector=${PGVECTOR_APT_VERSION}" \
 && rm -rf /var/lib/apt/lists/*

COPY --from=age-build /age-dist/ /

# ------------------------------------------------------------------------
# LAYER 2 — RUST CI BUILD DEPS (the apt set the pg-CI jobs install today)
# ------------------------------------------------------------------------
# The exact packages the postgres-backed jobs `apt-get install` at job start
# (grep of .github/workflows: mold, postgresql-client, jq, sqlite3,
# build-essential; `curl`/`ca-certificates` are the mold-tarball fetch
# prereqs). Baking them here is what removes the per-job apt-mirror flake for
# any job that runs INSIDE this image. `postgresql-client` is already provided
# by the postgresql-client-${PG_MAJOR} bumped in layer 1 (psql of the certified major on PATH); it
# is not re-installed. Kept as a distinct layer so the data tier above stays a
# verbatim copy of the deploy recipe.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential \
      jq \
      sqlite3 \
      curl \
      ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# mold — pinned to the SAME first-party release tarball the workflows fetch
# (MOLD_VERSION default matches the `MOLD_VERSION: "2.4.1"` pin in
# cert-postgres-age.yml / postgres-parity-nightly.yml / coverage.yml / ci.yml).
# Fetching it at IMAGE-BUILD time (a rare event) rather than per-job is the
# whole point: the tarball-fetch flake moves off the per-PR hot path. Pinned
# by version + verified on PATH; the build fails loudly if the pinned tarball
# is unavailable (no silent unpinned fallback in the image — the workflows'
# apt fallback exists only because they run per-PR).
ARG MOLD_VERSION=2.4.1
RUN set -eux; \
    arch="$(uname -m)"; \
    tgz="mold-${MOLD_VERSION}-${arch}-linux.tar.gz"; \
    url="https://github.com/rui314/mold/releases/download/v${MOLD_VERSION}/${tgz}"; \
    tmp="$(mktemp -d)"; \
    curl -fsSL --retry 3 --retry-delay 3 -o "${tmp}/${tgz}" "${url}"; \
    tar -xzf "${tmp}/${tgz}" -C "${tmp}"; \
    install -m0755 "${tmp}/mold-${MOLD_VERSION}-${arch}-linux/bin/mold" /usr/local/bin/mold; \
    ln -sf /usr/local/bin/mold /usr/local/bin/ld.mold; \
    rm -rf "${tmp}"; \
    mold --version | grep -q "${MOLD_VERSION}"

# Provenance labels (mirrors the release.yml GHCR image convention).
LABEL org.opencontainers.image.source="https://github.com/alphaonedev/ai-memory-mcp"
LABEL org.opencontainers.image.description="ai-memory CI image: certified data tier postgres=19.0 age=1.7.0 (built from upstream PG19 branch commit c6b043d1c8f4909331b9080d6640b487782fc958 plus upstream fix commit 06ce678d74210539705c77e2dc7c9fa861e2a331, apache/age#2581, not a tagged Apache release) pgvector=0.8.7 plus the Rust CI build deps (mold, build-essential, jq, sqlite3, postgresql-client)."
LABEL org.opencontainers.image.revision.age="${AGE_SOURCE_COMMIT}"

# The official postgres ENTRYPOINT + USER state are preserved; AGE is
# preloaded and auto-created via /docker-entrypoint-initdb.d, exactly as the
# deploy image, and a job may equally use this image as a `container:` for its
# baked build deps.
CMD ["postgres", "-c", "shared_preload_libraries=age"]
