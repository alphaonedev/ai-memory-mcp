# ai-memory — asi-hard PROCUREMENT deployment ENV template
# (v1.0.0, PE-1 / #1962; hardened posture / #1961; inference egress / #1963)
#
# The ENV half of the asi-hard template. Pair with config.asi-hard.toml.
# Load before launching the daemon, e.g.:
#
#   set -a; . /etc/ai-memory/asi-hard.env; set +a
#   ai-memory serve
#
# ONE named knob does the heavy lifting: AI_MEMORY_SECURITY_PROFILE=asi-hard
# engages the hardened, NO-DISABLE posture (src/security_profile.rs). At boot
# it PINS the fail-closed security env knobs ON and REFUSES to boot if an
# operator set any pinned knob BELOW its hard floor. You do NOT need to set
# the pinned knobs yourself — the profile pins them — but setting them to
# their hard value is harmless (accepted as already-compliant).

# ── The named hardened security posture (#1961). ─────────────────────────
# Pins (SSOT src/security_profile.rs::KNOBS): AI_MEMORY_SECRET_SCREEN_MODE=
# refuse; AI_MEMORY_REQUIRE_AGENT_ATTESTATION / FED_REQUIRE_WRITE_SIG /
# FED_REQUIRE_SIGNAL_SIG / FED_REQUIRE_TRANSITION_SIG /
# FED_REQUIRE_CHECKPOINT_SIG / FED_QUARANTINE_UNATTRIBUTED / CID_ENFORCE /
# REQUIRE_ROLLBACK_CHECK / REQUIRE_WITNESS / REQUIRE_CAUSE_BINDING /
# REQUIRE_ROLE_SEPARATION / REQUIRE_IDENTITY_LINEAGE /
# FED_REQUIRE_SERVER_VERIFY = 1;
# AI_MEMORY_DB_SYNCHRONOUS=FULL (power-loss durability); and
# AI_MEMORY_ALLOW_SCHEMA_AHEAD must be UNSET (#2445) — the schema-downgrade
# hatch is the one PERMISSIVE knob in the pinned set, so its hard floor is the
# inverse shape: under asi-hard an older binary may not open or write a
# database whose schema is newer than its own migration ladder produces, and
# setting the hatch to any value REFUSES boot rather than being honoured.
# FED_REQUIRE_SERVER_VERIFY (#2448) is the first NETWORK access-control knob
# in the pinned set: under asi-hard, `ai-memory sync-daemon
# --insecure-skip-server-verify` is REFUSED, so a procurement deployment of
# this template cannot push plaintext memory content to an unauthenticated
# peer server. Pin peer server certs with AI_MEMORY_FED_PEER_FINGERPRINTS. It also bridges
# [governance].require_operator_pubkey=true at the governance boot check.
AI_MEMORY_SECURITY_PROFILE=asi-hard

# ── Inference-plane egress posture (#1963, R68/D14). ─────────────────────
# The asi-hard security profile does NOT force this — inference egress is a
# deployment choice. `loopback-only` permits a LOCAL Ollama / self-hosted
# TEI on 127.0.0.1 but REFUSES shipping memory content to an external LLM /
# embedding vendor (a signed `egress.inference_refused` audit row is emitted
# and the outbound client is never constructed). Use `deny` for a fully
# air-gapped node (no inference egress at all). `allow` is the legacy
# default (any vendor) — NOT hardened.
AI_MEMORY_INFERENCE_EGRESS=loopback-only

# ── Optional operator key custody (recommended for asi-hard). ────────────
# The witness / role-separation / rollback-check require-modes pinned by the
# profile are only cryptographically load-bearing once the corresponding
# keys are enrolled. Point these at a mount the daemon can READ but a
# compromised daemon process cannot overwrite. Uncomment + set as needed:
# AI_MEMORY_WITNESS_KEY_DIR=/etc/ai-memory/witness-keys
# AI_MEMORY_WITNESS_PUBKEY=<base64-url-nopad-32-bytes>
# AI_MEMORY_RECORDER_KEY_DIR=/etc/ai-memory/recorder-keys
# AI_MEMORY_JUDGE_KEY_DIR=/etc/ai-memory/judge-keys
# AI_MEMORY_STOPPER_KEY_DIR=/etc/ai-memory/stopper-keys
# AI_MEMORY_OPERATOR_PUBKEY=<base64-32-bytes>
