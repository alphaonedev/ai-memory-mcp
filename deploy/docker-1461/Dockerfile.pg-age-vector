# PostgreSQL 19 + Apache AGE 1.7.0 + pgvector for the docker-1461 mesh.
#
# Certified data tier: PostgreSQL 19.0 + Apache AGE 1.7.0 + pgvector 0.8.7.
# Apache AGE 1.7.0 is built from upstream PG19 branch commit c6b043d (not a
# tagged Apache release; upstream has no 1.7.0 release for PostgreSQL 19).
# pgdg ships no `postgresql-19-age` package and apache/age publishes no PG19
# image, so the AGE layer is a source build of that ONE pinned commit,
# unmodified (no patch, no substitution). The tagged v1.7.0-rc0 source of the
# previous major does not compile against PostgreSQL 19 (changed executor and table-AM
# signatures); commit c6b043d is upstream's own PG19 port at
# default_version 1.7.0 (#2457).
#
#   Stage `age-build`: the official PostgreSQL image for the major, server +
#     server-dev bumped to the EXACT pgdg minor (PG_APT_VERSION), the AGE
#     source fetched at AGE_SOURCE_COMMIT and checked with `git rev-parse
#     HEAD` (a mismatch fails the build), then `make install` into a
#     staging DESTDIR.
#   Final stage: the same base, server + client bumped to PG_APT_VERSION,
#     pgvector from pgdg apt (PGVECTOR_APT_VERSION), the staged AGE files
#     copied in, and AGE's own initdb script so `CREATE EXTENSION age` runs
#     on first start, as the former apache/age base image did.
#
# Every version literal lives in ONE place (provision/lib.sh) and arrives
# here as a --build-arg; this Dockerfile carries no hardcoded version. A
# missing build arg fails the build (`: "${VAR:?}"`), never a silent default.

ARG PG_BASE_IMAGE
FROM ${PG_BASE_IMAGE} AS age-build

ARG PG_MAJOR
ARG PG_APT_VERSION
ARG AGE_SOURCE_REPO
ARG AGE_SOURCE_COMMIT

USER root

RUN : "${PG_MAJOR:?}" "${PG_APT_VERSION:?}" "${AGE_SOURCE_REPO:?}" "${AGE_SOURCE_COMMIT:?}" \
 && apt-get update \
 && apt-get install -y --no-install-recommends --only-upgrade \
      "postgresql-${PG_MAJOR}=${PG_APT_VERSION}" \
      "postgresql-client-${PG_MAJOR}=${PG_APT_VERSION}" \
 && apt-get install -y --no-install-recommends \
      "postgresql-server-dev-${PG_MAJOR}=${PG_APT_VERSION}" \
      bison build-essential ca-certificates flex git \
 && git init -q /src/age \
 && git -C /src/age remote add origin "${AGE_SOURCE_REPO}" \
 && git -C /src/age fetch -q --depth 1 origin "${AGE_SOURCE_COMMIT}" \
 && git -C /src/age checkout -q --detach FETCH_HEAD \
 && test "$(git -C /src/age rev-parse HEAD)" = "${AGE_SOURCE_COMMIT}" \
 && make -C /src/age -j"$(nproc)" PG_CONFIG="/usr/lib/postgresql/${PG_MAJOR}/bin/pg_config" \
 && make -C /src/age install DESTDIR=/age-dist PG_CONFIG="/usr/lib/postgresql/${PG_MAJOR}/bin/pg_config" \
 && install -D -m 0644 /src/age/docker/docker-entrypoint-initdb.d/00-create-extension-age.sql \
      /age-dist/docker-entrypoint-initdb.d/00-create-extension-age.sql

ARG PG_BASE_IMAGE
FROM ${PG_BASE_IMAGE}

# Re-declare post-FROM so the build args are in scope for the RUN layer.
ARG PG_MAJOR
ARG PG_APT_VERSION
ARG PGVECTOR_APT_VERSION

USER root

# Pinned, reproducible: exact minor for server + client and exact pgvector
# from pgdg apt; AGE from the pinned-commit build stage above.
RUN : "${PG_MAJOR:?}" "${PG_APT_VERSION:?}" "${PGVECTOR_APT_VERSION:?}" \
 && apt-get update \
 && apt-get install -y --no-install-recommends --only-upgrade \
      "postgresql-${PG_MAJOR}=${PG_APT_VERSION}" \
      "postgresql-client-${PG_MAJOR}=${PG_APT_VERSION}" \
 && apt-get install -y --no-install-recommends \
      "postgresql-${PG_MAJOR}-pgvector=${PGVECTOR_APT_VERSION}" \
 && rm -rf /var/lib/apt/lists/*

COPY --from=age-build /age-dist/ /

# Fail-closed hostssl healthcheck (#2658). Baked in so "healthy" means
# "hostssl PROVABLY armed" (a plaintext sslmode=disable TCP connection is
# refused pre-auth), not merely "postmaster up on the local socket". The
# compose healthcheck invokes this; provision/50_up.sh blocks on healthy.
COPY pg-hostssl-healthcheck.sh /usr/local/bin/pg-hostssl-healthcheck.sh
RUN chmod 0755 /usr/local/bin/pg-hostssl-healthcheck.sh

# Official postgres entrypoint + USER state preserved; AGE is preloaded and
# auto-created via /docker-entrypoint-initdb.d/00-create-extension-age.sql,
# exactly as the former apache/age base image's CMD did.
CMD ["postgres", "-c", "shared_preload_libraries=age"]
